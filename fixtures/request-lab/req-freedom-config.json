{
  "schemaVersion": 2,
  "exportedAt": "2026-07-25T00:00:00.000Z",
  "enabled": true,
  "groups": [
    {
      "id": "grp-dnr",
      "name": "01 DNR 网络规则",
      "enabled": true,
      "updatedAt": "2026-07-25T00:00:00.000Z",
      "rules": [
        {
          "id": "rule-block-tracker",
          "name": "拦截 tracker.svg 资源",
          "enabled": true,
          "channel": "dnr",
          "methods": ["GET"],
          "matchType": "contains",
          "pattern": "/assets/tracker.svg",
          "actions": [{ "type": "block" }]
        },
        {
          "id": "rule-redirect-source",
          "name": "GET redirect-source → redirect-target",
          "enabled": true,
          "channel": "dnr",
          "methods": ["GET"],
          "matchType": "contains",
          "pattern": "/api/redirect-source.json",
          "actions": [{ "type": "redirect", "redirectUrl": "http://127.0.0.1:4317/api/redirect-target.json" }]
        },
        {
          "id": "rule-inject-params",
          "name": "GET /api/params 注入查询参数",
          "enabled": true,
          "channel": "dnr",
          "methods": ["GET"],
          "matchType": "contains",
          "pattern": "/api/params.json",
          "actions": [
            { "type": "inject-params", "params": { "debug": "1", "environment": "local" } },
            {
              "type": "modify-headers",
              "headers": [{ "target": "request", "operation": "set", "header": "X-Req-Freedom", "value": "enabled" }]
            }
          ]
        },
        {
          "id": "rule-modify-headers",
          "name": "GET /api/headers 改写请求和响应 Header",
          "enabled": true,
          "channel": "dnr",
          "methods": ["GET"],
          "matchType": "contains",
          "pattern": "/api/headers.json",
          "actions": [{
            "type": "modify-headers",
            "headers": [
              { "target": "request", "operation": "set", "header": "X-Req-Freedom", "value": "enabled" },
              { "target": "request", "operation": "remove", "header": "X-Remove-Me" },
              { "target": "response", "operation": "set", "header": "X-Response-Patched", "value": "true" }
            ]
          }]
        },
        {
          "id": "rule-modify-cookies",
          "name": "GET /api/cookies 双向追加 Cookie",
          "enabled": true,
          "channel": "dnr",
          "methods": ["GET"],
          "matchType": "contains",
          "pattern": "/api/cookies",
          "actions": [{
            "type": "modify-headers",
            "headers": [
              { "target": "request", "operation": "append", "header": "Cookie", "value": "req_freedom_request=enabled" },
              { "target": "response", "operation": "append", "header": "Set-Cookie", "value": "req_freedom_response=enabled; Path=/" }
            ]
          }]
        },
        {
          "id": "rule-enable-cors",
          "name": "为被拦跨域端点补充 CORS 响应头",
          "enabled": true,
          "channel": "dnr",
          "methods": ["GET"],
          "matchType": "contains",
          "pattern": "/api/cross-origin/blocked",
          "actions": [{
            "type": "modify-headers",
            "headers": [{ "target": "response", "operation": "set", "header": "Access-Control-Allow-Origin", "value": "*" }]
          }]
        },
        {
          "id": "rule-block-delete",
          "name": "DELETE /api/methods 直接拦截",
          "enabled": true,
          "channel": "dnr",
          "methods": ["DELETE"],
          "matchType": "contains",
          "pattern": "/api/methods",
          "actions": [{ "type": "block" }]
        },
        {
          "id": "rule-invalid-regex",
          "name": "非法正则（浏览器会拒绝注册）",
          "enabled": true,
          "channel": "dnr",
          "methods": ["GET"],
          "matchType": "regex",
          "pattern": "/api/registration-probe(?=\\.json)",
          "actions": [{ "type": "block" }]
        }
      ]
    },
    {
      "id": "grp-page-patch",
      "name": "02 页面补丁（Mock / 限速 / 改请求体）",
      "enabled": true,
      "updatedAt": "2026-07-25T00:00:00.000Z",
      "rules": [
        {
          "id": "rule-mock-users",
          "name": "GET /api/users.json 返回 Mock",
          "enabled": true,
          "channel": "page-patch",
          "methods": ["GET"],
          "matchType": "contains",
          "pattern": "/api/users.json",
          "actions": [{
            "type": "mock-response",
            "mode": "static",
            "statusCode": 503,
            "responseHeaders": { "X-Mocked-By": "req-freedom" },
            "body": "{\"code\":503,\"message\":\"mocked\"}"
          }]
        },
        {
          "id": "rule-mock-products",
          "name": "GET /api/products.json 返回 XHR Mock",
          "enabled": true,
          "channel": "page-patch",
          "methods": ["GET"],
          "matchType": "contains",
          "pattern": "/api/products.json",
          "actions": [{
            "type": "mock-response",
            "mode": "static",
            "statusCode": 200,
            "responseHeaders": { "X-Mocked-By": "req-freedom" },
            "body": "{\"source\":\"xhr-mock\",\"items\":[]}"
          }]
        },
        {
          "id": "rule-mock-status-404",
          "name": "GET /api/status/404 Mock 为 200",
          "enabled": true,
          "channel": "page-patch",
          "methods": ["GET"],
          "matchType": "contains",
          "pattern": "/api/status/404",
          "actions": [{
            "type": "mock-response",
            "mode": "static",
            "statusCode": 200,
            "responseHeaders": { "X-Mocked-By": "req-freedom" },
            "body": "{\"code\":200,\"message\":\"404 已被 Mock 覆盖\"}"
          }]
        },
        {
          "id": "rule-slow-response",
          "name": "GET 大响应限速 150 kB/s",
          "enabled": true,
          "channel": "page-patch",
          "methods": ["GET"],
          "matchType": "contains",
          "pattern": "/api/slow-response.txt",
          "actions": [{ "type": "delay", "throttlePreset": "custom", "latencyMs": 400, "downloadKbps": 1200, "uploadKbps": 1200 }]
        },
        {
          "id": "rule-slow-upload",
          "name": "POST /api/upload-probe 限制上行带宽",
          "enabled": true,
          "channel": "page-patch",
          "methods": ["POST"],
          "matchType": "contains",
          "pattern": "/api/upload-probe",
          "actions": [{ "type": "delay", "throttlePreset": "custom", "latencyMs": 0, "downloadKbps": 0, "uploadKbps": 128 }]
        },
        {
          "id": "rule-body-dynamic-echo",
          "name": "POST /api/echo 动态生成请求体",
          "enabled": true,
          "channel": "page-patch",
          "methods": ["POST"],
          "matchType": "contains",
          "pattern": "/api/echo",
          "actions": [{
            "type": "modify-request-body",
            "sourceMode": "dynamic",
            "mode": "merge-json",
            "content": "",
            "functionCode": "function modify(req) { return { ...req.json, variables: { ...req.json?.variables, first: 100, dynamic: true } }; }"
          }]
        },
        {
          "id": "rule-graphql-getuser-mock",
          "name": "POST /api/graphql 仅 Mock GetUser 操作",
          "enabled": true,
          "channel": "page-patch",
          "methods": ["POST"],
          "matchType": "contains",
          "pattern": "/api/graphql",
          "bodyMatch": { "type": "graphql-operation", "value": "GetUser" },
          "actions": [{
            "type": "mock-response",
            "mode": "static",
            "statusCode": 200,
            "responseHeaders": { "X-Mocked-By": "req-freedom" },
            "body": "{\"data\":{\"user\":{\"id\":99,\"name\":\"Mock 用户\",\"role\":\"mocked\"}},\"receivedOperationName\":\"GetUser\",\"mocked\":true}"
          }]
        },
        {
          "id": "rule-mock-opaque",
          "name": "不透明响应上的 Mock（预期无法应用）",
          "enabled": true,
          "channel": "page-patch",
          "methods": ["GET"],
          "matchType": "contains",
          "pattern": "/api/cross-origin/opaque",
          "actions": [{
            "type": "mock-response",
            "mode": "dynamic",
            "passthrough": true,
            "statusCode": 200,
            "statusText": "OK",
            "body": "",
            "functionCode": "function mock(req, res) { return { patched: true, original: res.json }; }"
          }]
        },
        {
          "id": "rule-mock-sync-xhr",
          "name": "同步 XHR 上的 Mock（预期无法应用）",
          "enabled": true,
          "channel": "page-patch",
          "methods": ["GET"],
          "matchType": "contains",
          "pattern": "/api/sync-xhr.json",
          "actions": [{
            "type": "mock-response",
            "mode": "static",
            "statusCode": 200,
            "statusText": "OK",
            "bodyType": "json",
            "body": "{\"source\":\"mock\",\"note\":\"若读到这段内容，说明同步 XHR 没有被放行\"}"
          }]
        }
      ]
    },
    {
      "id": "grp-page-script",
      "name": "03 页面脚本注入",
      "enabled": true,
      "updatedAt": "2026-07-25T00:00:00.000Z",
      "rules": [{
        "id": "rule-insert-script",
        "name": "加载完成后注入调试标记",
        "enabled": true,
        "channel": "page-patch",
        "methods": ["GET"],
        "matchType": "contains",
        "pattern": "127.0.0.1:4317",
        "actions": [{ "type": "insert-script", "codeType": "js", "timing": "document_end", "code": "window.__REQ_FREEDOM_LAB__ = '已由 ReqFreedom 注入'; document.documentElement.dataset.reqFreedom = 'enabled';" }]
      }]
    }
  ]
}
